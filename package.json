{
  "name": "project-guardian-mcp",
  "version": "2.0.0-beta-3",
  "description": "Project Guardian MCP - A focused Model Context Protocol server for project memory management and workflow guardianship with knowledge graph capabilities",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:prod": "mkdir -p .tmp && cp package.prod.json .tmp/package.json && cd .tmp && npm install --production && cd .. && npx esbuild src/index.ts --bundle --minify --platform=node --format=esm --target=node18 --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:sqlite3 --external:zod --external:redis && rm -rf .tmp",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --maxWorkers=2",
    "clean": "rm -rf dist coverage .tmp",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run clean && npm run build:prod"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "project-guardian",
    "memory-management",
    "knowledge-graph",
    "project-management",
    "workflow-guardian",
    "sqlite",
    "knowledge-base"
  ],
  "author": "1999AZZAR",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "redis": "^4.7.1",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.7"
  }
}
